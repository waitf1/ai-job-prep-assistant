# Copy to .env and fill in your own provider settings. Never commit .env.
# Use your provider's OpenAI-compatible API base URL, usually ending in /v1.
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace_with_your_api_key
LLM_MODEL=replace_with_your_model_name
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Character limit, not a token limit.
LLM_MAX_INPUT_CHARS=100000
